{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Compact",
  "scopeName": "source.compact",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragma" },
    { "include": "#import" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#ledger-adts" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.compact",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.compact",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.compact",
          "match": "//.*$"
        }
      ]
    },
    "pragma": {
      "match": "\\b(pragma)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([^;]+)(;)",
      "captures": {
        "1": { "name": "keyword.control.directive.pragma.compact" },
        "2": { "name": "entity.name.tag.pragma.compact" },
        "3": { "name": "constant.numeric.version.compact" }
      }
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"[^\"]+\"|[A-Za-z_][A-Za-z0-9_]*)(?:\\s+(prefix)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.compact" },
            "2": { "name": "string.quoted.double.module.compact" },
            "3": { "name": "keyword.control.import.compact" },
            "4": { "name": "entity.name.namespace.compact" }
          }
        },
        {
          "match": "\\b(include)\\s+(\"[^\"]+\")",
          "captures": {
            "1": { "name": "keyword.control.import.compact" },
            "2": { "name": "string.quoted.double.module.compact" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.module.compact" },
            "2": { "name": "entity.name.namespace.compact" }
          }
        },
        {
          "match": "\\b(?:(export)\\s+)?(?:(pure)\\s+)?(circuit)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.export.compact" },
            "2": { "name": "storage.modifier.pure.compact" },
            "3": { "name": "storage.type.circuit.compact" },
            "4": { "name": "entity.name.function.circuit.compact" }
          }
        },
        {
          "match": "\\b(?:(export)\\s+)?(witness)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.export.compact" },
            "2": { "name": "storage.type.witness.compact" },
            "3": { "name": "entity.name.function.witness.compact" }
          }
        },
        {
          "match": "\\b(?:(export)\\s+)?(?:(sealed)\\s+)?(ledger)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.export.compact" },
            "2": { "name": "storage.modifier.sealed.compact" },
            "3": { "name": "storage.type.ledger.compact" },
            "4": { "name": "variable.other.constant.ledger.compact" }
          }
        },
        {
          "match": "\\b(?:(export)\\s+)?(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.export.compact" },
            "2": { "name": "storage.type.struct.compact" },
            "3": { "name": "entity.name.type.compact" }
          }
        },
        {
          "match": "\\b(constructor)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.constructor.compact" }
          }
        },
        {
          "match": "\\b(contract)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.contract.compact" },
            "2": { "name": "entity.name.type.contract.compact" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.compact",
          "match": "\\b(if|else|for|in|to|do|return|fold|map|over)\\b"
        },
        {
          "name": "keyword.other.compact",
          "match": "\\b(assert|as|const|new|pad|default|disclose)\\b"
        },
        {
          "name": "storage.modifier.compact",
          "match": "\\b(export|sealed|pure)\\b"
        },
        {
          "name": "storage.type.compact",
          "match": "\\b(circuit|witness|ledger|struct|enum|module|contract|constructor)\\b"
        },
        {
          "name": "constant.language.null.compact",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.compact",
          "match": "\\b(Boolean|Field|Bytes|Uint|Integer|Unsigned|Opaque|Vector|Void)\\b"
        },
        {
          "name": "support.type.builtin.compact",
          "match": "\\b(ShieldedCoinInfo|QualifiedShieldedCoinInfo|CoinInfo|QualifiedCoinInfo|ZswapCoinPublicKey|ContractAddress|UserAddress|Either|Maybe|CurvePoint)\\b"
        }
      ]
    },
    "ledger-adts": {
      "name": "support.class.ledger.compact",
      "match": "\\b(Counter|Cell|Set|List|Map|MerkleTree|HistoricMerkleTree|Kernel)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.compact",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.compact",
          "match": "\\b0[xX][0-9a-fA-F](?:[0-9a-fA-F_])*\\b"
        },
        {
          "name": "constant.numeric.binary.compact",
          "match": "\\b0[bB][01](?:[01_])*\\b"
        },
        {
          "name": "constant.numeric.decimal.compact",
          "match": "\\b[0-9](?:[0-9_])*\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.compact",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.compact",
          "match": "\\\\."
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=(?:<[^<>;{}]*>)?\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.compact" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.compact",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.compact",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.compact",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.compact",
          "match": "="
        },
        {
          "name": "punctuation.accessor.compact",
          "match": "\\.\\.\\.|\\."
        }
      ]
    }
  }
}
